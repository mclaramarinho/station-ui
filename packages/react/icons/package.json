{
  "name": "@station-ui/icons-react",
  "version": "1.0.0",
  "description": "React SVG icon components for Station UI",
  "license": "MIT",
  "author": "Clara Marinho",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./outline": {
      "types": "./src/outline.d.ts",
      "import": "./src/outline.js"
    },
    "./solid": {
      "types": "./src/solid.d.ts",
      "import": "./src/solid.js"
    },
    "./custom": {
      "types": "./src/custom.d.ts",
      "import": "./src/custom.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md"
  ],
  "peerDependencies": {
    "react": ">=16.8.0"
  }
}
