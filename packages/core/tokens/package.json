{
  "name": "@station-ui/tokens",
  "version": "1.0.0",
  "description": "Station UI design tokens and Sass utilities",
  "license": "MIT",
  "author": "Clara Marinho <marinho.claramb@gmail.com>",
  "maintainers": [
    "Clara Marinho <marinho.claramb@gmail.com>"
  ],
  "keywords": [
    "design",
    "tokens",
    "Sass",
    "JavaScript",
    "stationui",
    "design system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mclaramarinho/station-ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/generated/js/tokens.js",
