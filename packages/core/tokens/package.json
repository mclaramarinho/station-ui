  "exports": {
    ".": "./src/generated/js/tokens.js",
    "./scss": "./src/generated/scss/_tokens.scss",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "src/generated/js",
    "src/generated/scss",
    "src/styles",
    "src/tokens.json",
    "config.json",
    "build.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "sass": "^1.89.2",
    "style-dictionary": "^5.5.3"
  }
}