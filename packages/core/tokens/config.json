{
  "source": ["src/tokens.json"],
  "platforms": {
    "scss": {
      "transformGroup": "scss",
      "buildPath": "src/generated/scss/",
      "files": [
        {
          "destination": "_tokens.scss",
          "format": "scss/variables"
        }
      ]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "src/generated/js/",
      "files": [
        {
          "destination": "tokens.js",
          "format": "javascript/es6"
        }
      ]
    },
    "flutter": {
      "transformGroup": "flutter",
      "buildPath": "../../flutter/tokens/lib/generated/",
      "files": [
        {
          "destination": "tokens.dart",
          "format": "station/dart-class",
          "options": {
            "className": "StationTokens"
          }
        }
      ]
    }
  }
}